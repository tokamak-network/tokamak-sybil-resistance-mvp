   Select[allverts1, #[[1]] >= xm1 && #[[2]] >= ym1 && #[[3]] >= 
       zm1 && #[[1]] <= (p1 + a1)^2 && #[[2]] <= (q1 + b1)^2 && #[[
        3]] <= (a1 + b1)^2 && #[[2]] + #[[3]] <= (q1 + a1)^2 && #[[
         1]] + #[[2]] + #[[3]] <= (p1 + q1)^2 && #[[1]] + #[[
         3]] <= (p1 + b1)^2 &];
  paretoverts = -Internal`ListMin[-polytopeverts];
  paretoverts
  ]
