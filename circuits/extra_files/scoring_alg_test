pareto[xm1_, ym1_, zm1_, a1_, b1_] := 
 Module[{allverts1, polytopeverts, paretoverts},
  allverts1 = 
   allverts /. {xm -> xm1, ym -> ym1, zm -> zm1, a -> a1, b -> b1, 
     p -> p1, q -> q1};
