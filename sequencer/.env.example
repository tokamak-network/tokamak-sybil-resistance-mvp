APP_MODE=local # local, test, main

# only required for running sequencer on AWS test/main mode
AWS_REGION=

BootCoordinator=
BootCoordinatorURL=

# PostgreSQL connection parameters for local
PGUSER=postgres
PGPASSWORD=123
PGDATABASE=statedb

# PostgreSQL connection parameters for test on aws
TEST_AWS_DB_SECRET_NAME=

# PostgreSQL connection parameters for main on aws
MAIN_AWS_DB_SECRET_NAME=

# Logging for testing
DEBUG=false

# Logging for app
LOG_LEVEL=debug # debug, info, warn, error
OUT_PATH=stdout
MEDDLER_LOGS=false # Enables meddler debug mode, where unused columns and struct fields will be logged

# Keystore
KEYSTORE_PATH="./var/tokamak/ethkeystore"
KEYSTORE_PASSWORD="123"
FORGER_ADDRESS=

# Coordinator Etherscan
# If this parameter is set, specifies the etherscan endpoint to get the gas estimations for that momment
ETHERSCAN_URL="https://api.etherscan.io"
ETHERSCAN_API_KEY=

# Sync
ROLLUP_START_BLOCK_NUM="7754027"
WAIT_TIME_SECONDS="10"
MAXTX="100"
NLEVEL="5"